#!/bin/sh
# hangar - the board's side of vodloop v2. From cron, every five minutes.
#
#   hangar          ship what a channel asks for, then fill the hangar
#   hangar --dry    say what it would do, touch nothing
#
# The board has the home address, which YouTube lets through, and a 128 Go
# card. Oracle has neither, and sits behind no NAT, so the board always asks:
#   ship: state/want.json says how short the channel's queue is and how heavy a
#         delivery may be. A random file of the hangar that fits goes up to
#         upload/, is checked byte for byte, and enters queue/ in one mv.
#   fill: state/candidates.tsv is the channel's catalogue minus what Oracle has
#         or aired lately. One random candidate is downloaded, whole, avc1+mp4a.
# Shipping never touches YouTube, so it is not paced. Filling is, because the
# address is what gets flagged: 28 Go in ten hours had it refused on 2026-09-14.
#
# sh and awk only: one RISC-V core and 211 Mo of RAM, and python3 on top of a
# download starves sshd for a quarter of an hour.
set -u

BASE=/root/v2
CONF=$BASE/hangar.conf
LOCK=/tmp/hangar.lock
LOG=$BASE/hangar.log
V2=/home/ubuntu/v2
ORACLE=ubuntu@89.168.60.67
KEY=/root/.ssh/oracle_key
CHANNELS=""
GAP_MIN=90
FAIL_GAP_MIN=180
DAY_MB=16000
KEEP_FREE_MB=12000
HANGAR_MB=80000
MAX_FILE_MB=10000
MAX_FAILS=3
# How far down the candidate list the draw may go. Oracle writes it sources in
# turn, each newest first, so the head is the recent material of every source.
# Without this the draw was uniform over three years of catalogue and the
# channel aired a batch of very old videos in a row.
RECENT=120
[ -f "$CONF" ] && . "$CONF"

DRY=""
[ "${1:-}" = "--dry" ] && DRY=1
OSSH="ssh -i $KEY -o BatchMode=yes -o ConnectTimeout=20 -o StrictHostKeyChecking=accept-new"
ts() { date '+%Y-%m-%d %H:%M:%S'; }
# a dry run says what it would do on the terminal and leaves the log alone:
# its lines read exactly like real ones the next morning
log() { [ -z "$DRY" ] || { echo "$*"; return; }; echo "$(ts) $*" >> "$LOG"; }
num() { case "$1" in "" | *[!0-9]*) echo 0 ;; *) echo "$1" ;; esac; }
field() { printf '%s' "$2" | sed -n "s/.*\"$1\": *\([0-9]*\).*/\1/p" | head -1; }
bytes() { ls -ln "$1" 2>/dev/null | awk '{print $5}'; }

mkdir -p "$BASE"
# yt-dlp writes into this log, so it grows by megabytes a day on a card that
# also holds the hangar. Kept to its last two thousand lines.
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 5000000 ]; then
  tail -n 2000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi
# --- report ----------------------------------------------------------------
# A beacon, sent on every tick even when another run holds the lock: a fetch
# takes the best part of an hour, and without this the watcher on the far side
# reads a board that has not spoken since it started and calls it dead.
report() {
  [ -z "$DRY" ] || return 0
  free=$(df -Pm "$BASE" | tail -1 | awk '{print $4}')
  parts=""
  for chan in $CHANNELS; do
    n=$(ls "$BASE/hangar/$chan" 2>/dev/null | grep -c '\.m[kp][v4]$')
    mb=$(du -sm "$BASE/hangar/$chan" 2>/dev/null | cut -f1)
    parts="$parts${parts:+,}\"$chan\":{\"files\":$(num "$n"),\"mb\":$(num "$mb")}"
  done
  last_at=0; last_res=none
  [ -f "$BASE/last" ] && read -r last_at last_res < "$BASE/last"
  printf '{"at":%s,"free_mb":%s,"last_fetch":%s,"last_result":"%s","hangar":{%s}}'     "$(date +%s)" "$(num "$free")" "$(num "$last_at")" "$last_res" "$parts"     | $OSSH "$ORACLE" "cat > $V2/board.json.tmp && mv $V2/board.json.tmp $V2/board.json" 2>/dev/null
}

report

if [ -z "$DRY" ]; then
  # the owner's pid, not the lock's age, says whether a run is still alive:
  # an age threshold once declared an eleven hour download orphaned mid-merge
  if [ -d "$LOCK" ]; then
    owner=$(cat "$LOCK/pid" 2>/dev/null)
    [ -n "$owner" ] && [ -d "/proc/$owner" ] && exit 0
    rm -rf "$LOCK"
  fi
  mkdir "$LOCK" 2>/dev/null || exit 0
  echo $$ > "$LOCK/pid"
  trap 'rm -rf "$LOCK"' EXIT INT TERM
fi

for chan in $CHANNELS; do
  case "$chan" in *[!a-z0-9-]*) log "canal refuse: $chan"; exit 1 ;; esac
done

# --- ship ------------------------------------------------------------------
ship() {
  chan=$1
  dir=$BASE/hangar/$chan
  want=$($OSSH "$ORACLE" "cat $V2/$chan/state/want.json" 2>/dev/null) || { log "$chan: Oracle injoignable"; return 1; }
  need=$(num "$(field need_seconds "$want")")
  offer=$(num "$(field offer_bytes "$want")")
  at=$(num "$(field at "$want")")
  shipped=$(num "$(cat "$BASE/$chan.shipped" 2>/dev/null)")
  now=$(date +%s)
  [ "$need" -gt 0 ] || return 0
  # an offer written before the last delivery landed does not know about it
  [ "$at" -gt "$shipped" ] || return 0
  [ $((now - at)) -lt 1800 ] || { log "$chan: want.json perime ($((now - at)) s)"; return 0; }
  pick=$(for f in "$dir"/*.mkv "$dir"/*.mp4; do
           [ -f "$f" ] && echo "$(bytes "$f") $f"
         done | awk -v max="$offer" 'BEGIN { srand() } $1 > 0 && $1 <= max { c[++k] = $2 }
                                     END { if (k) print c[int(rand() * k) + 1] }')
  if [ -z "$pick" ]; then
    [ -z "$DRY" ] || log "$chan: besoin $((need / 3600)) h mais rien au hangar sous $((offer / 1048576)) Mo"
    return 0
  fi
  name=$(basename "$pick")
  size=$(bytes "$pick")
  log "$chan: envoi $name ($((size / 1048576)) Mo), besoin $((need / 3600)) h"
  [ -z "$DRY" ] || return 0
  scp -i "$KEY" -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$pick" "$ORACLE:$V2/$chan/upload/" >> "$LOG" 2>&1 \
    || { log "$chan: scp a echoue"; return 1; }
  remote=$($OSSH "$ORACLE" "stat -c %s '$V2/$chan/upload/$name'" 2>/dev/null)
  if [ "$remote" != "$size" ]; then
    $OSSH "$ORACLE" "rm -f '$V2/$chan/upload/$name'" 2>/dev/null
    log "$chan: taille distante $remote contre $size, envoi annule, copie gardee"
    return 1
  fi
  $OSSH "$ORACLE" "mv '$V2/$chan/upload/$name' '$V2/$chan/queue/$now-$name'" \
    || { log "$chan: mise en file impossible"; return 1; }
  rm -f "$pick"
  date +%s > "$BASE/$chan.shipped"
  echo "$(date +%s) $chan $name" >> "$BASE/shipped.tsv"
  log "$chan: en file $now-$name"
}

# --- fill ------------------------------------------------------------------
fill() {
  chan=$1
  dir=$BASE/hangar/$chan
  mkdir -p "$dir/.part"
  now=$(date +%s)
  held=$(du -sm "$dir" | cut -f1)
  [ "$held" -lt "$HANGAR_MB" ] || { [ -z "$DRY" ] || log "$chan: hangar plein ($held Mo)"; return 1; }
  free=$(df -Pm "$BASE" | tail -1 | awk '{print $4}')
  [ "$free" -gt "$KEEP_FREE_MB" ] || { log "$chan: carte a $free Mo libres"; return 1; }
  last_at=0; last_res=ok
  [ -f "$BASE/last" ] && read -r last_at last_res < "$BASE/last"
  gap=$GAP_MIN
  [ "$last_res" = fail ] && gap=$FAIL_GAP_MIN
  wait_s=$(( $(num "$last_at") + gap * 60 - now ))
  [ "$wait_s" -le 0 ] || { [ -z "$DRY" ] || log "prochain telechargement dans $((wait_s / 60 + 1)) min"; return 1; }
  day_kb=$(awk -v t=$((now - 86400)) '$1 >= t { s += $2 } END { print s + 0 }' "$BASE/fetched.tsv" 2>/dev/null)
  [ "$(num "$day_kb")" -lt $((DAY_MB * 1024)) ] || { log "plafond 24 h atteint ($((day_kb / 1024)) Mo)"; return 1; }

  want=$($OSSH "$ORACLE" "cat $V2/$chan/state/want.json" 2>/dev/null) || return 1
  maxh=$(num "$(field maxh "$want")")
  case "$maxh" in 1080 | 720 | 480) ;; *) maxh=720 ;; esac
  minh=$(num "$(field minh "$want")")
  case "$minh" in 1080 | 720 | 480) ;; *) minh=480 ;; esac
  [ "$minh" -le "$maxh" ] || minh=$maxh
  cands=$($OSSH "$ORACLE" "cat $V2/$chan/state/candidates.tsv" 2>/dev/null) || return 1
  cands=$(printf '%s\n' "$cands" | head -n "$RECENT")
  # A channel with an empty queue is on its standby clip right now, and the
  # question stops being which video deserves a turn: it is which one is on the
  # air soonest. A fetch costs about the same whatever it brings back, so the
  # shortest candidates go first until something is queued.
  if [ "$(num "$(field queue_files "$want")")" -eq 0 ]; then
    cands=$(printf '%s\n' "$cands" | sort -k2 -n | head -20)
    log "$chan: file vide, tirage parmi les 20 plus courtes"
  fi
  skip=$( { ls "$dir" | sed -n 's/.*-\([A-Za-z0-9_-]\{11\}\)\.[a-z0-9]*$/\1/p'
            awk -v t=$((now - 7 * 86400)) -v m="$MAX_FAILS" \
              '$1 >= t { c[$2]++ } END { for (k in c) if (c[k] >= m) print k }' "$BASE/failed.tsv" 2>/dev/null
          } | tr '\n' ' ')
  vid=$(printf '%s\n' "$cands" | awk -v skip="$skip" '
    BEGIN { n = split(skip, s, " "); for (i = 1; i <= n; i++) x[s[i]] = 1; srand() }
    NF >= 2 && length($1) == 11 && !($1 in x) { c[++k] = $1 }
    END { if (k) print c[int(rand() * k) + 1] }')
  [ -n "$vid" ] || { log "$chan: aucun candidat"; echo "$now ok" > "$BASE/last"; return 1; }
  log "$chan: telecharge $vid en ${maxh}p (hangar $held Mo, 24 h $((day_kb / 1024)) Mo)"
  [ -z "$DRY" ] || return 0
  date +%s > "$BASE/$chan.tried"

  rm -f "$dir/.part"/*
  cookies=""
  [ -s "$BASE/cookies.txt" ] && cookies="$BASE/cookies.txt"
  # Nothing under the channel's floor is ever taken, whatever the cap: kil,
  # 2026-09-19, "720p minimum". Above it, https before m3u8 and a size term on
  # filesize, for one reason each, both learned the hard way on 2026-09-19:
  #   - m3u8 carries the same picture at a higher bitrate (4740k against 2960k
  #     for ax0pvdRtxRI) and yt-dlp reassembles its fragments in memory, which
  #     on 211 Mo of RAM is how yt-dlp gets killed mid-fetch.
  #   - an https rung knows its exact size and publishes it as filesize, not as
  #     filesize_approx, which is null there. Filtering on filesize_approx alone
  #     excluded every exact rung and collapsed the ladder onto the last one.
  # The cap is on the merged file, which is the one the far side weighs, but a
  # format filter only sees one track: 5000M of video plus its own audio merged
  # to 5199 Mo against a 5120 Mo ceiling, and that file sat unshippable on the
  # card all morning while the channel ran dry. The video rungs leave room for
  # the sound; --max-filesize stays the per-track backstop.
  vid_mb=$((MAX_FILE_MB - 400))
  fmt="bv*[vcodec^=avc1][protocol^=https][height<=$maxh][height>=$minh][filesize<${vid_mb}M]+ba[acodec^=mp4a]"
  fmt="$fmt/bv*[vcodec^=avc1][height<=$maxh][height>=$minh][filesize_approx<${vid_mb}M]+ba[acodec^=mp4a]"
  # The rung for a video that publishes no size at all. "<?" keeps a format
  # whose size is unknown and drops one known to be over: without the "?" this
  # rung had no size term at all and started 8JQEBshjMZY, whose only 720p rung
  # is 5001 Mo against a 5000 Mo cap, then --max-filesize aborted it half an
  # hour in. A size that is known and too big is knowable in a second.
  fmt="$fmt/bv*[vcodec^=avc1][protocol^=https][height<=$minh][height>=$minh][filesize<?${vid_mb}M][filesize_approx<?${vid_mb}M]+ba[acodec^=mp4a]"
  # yt-dlp answers into a file of its own, not into the shared log: the verdict
  # below was read from "tail -5 $LOG", which on 2026-09-19 still held the line
  # of the run before it and told Oracle to blacklist ax0pvdRtxRI for a shape
  # problem it does not have. A rejection is forever, so it is read from this
  # run and nothing else.
  run="$dir/.part/run.log"
  if yt-dlp --force-ipv4 ${cookies:+--cookies "$cookies"} --no-playlist --restrict-filenames \
       --no-progress --max-filesize "${MAX_FILE_MB}M" \
       -f "$fmt" \
       --merge-output-format mkv -P "$dir/.part" -o '%(title).80B-%(id)s.%(ext)s' \
       "https://www.youtube.com/watch?v=$vid" > "$run" 2>&1; then
    got=$(ls "$dir/.part"/*-"$vid".mkv 2>/dev/null | head -1)
  else
    got=""
    # A video that does not exist in the shape the wire needs never will, so
    # the far side is told once and stops offering it.
    if grep -q "Requested format is not available" "$run"; then
      # Two shapes reach this line and both are permanent: nothing in avc1 at
      # the floor, or nothing at the floor that fits the cap. The ledger says
      # what was asked for rather than guessing which of the two it was.
      $OSSH "$ORACLE" "printf '%s\t%s\tpas d avc1 %s lignes sous %s Mo\n' $(date +%s) '$vid' '$minh' '$MAX_FILE_MB' >> $V2/$chan/state/rejected.tsv" 2>/dev/null
      log "$chan: $vid n'a pas d'avc1 a $minh lignes sous $MAX_FILE_MB Mo, signale a Oracle"
    fi
  fi
  cat "$run" >> "$LOG" 2>/dev/null
  if [ -n "$got" ] && [ -f "$got" ]; then
    kb=$(( $(bytes "$got") / 1024 ))
    mv "$got" "$dir/"
    echo "$(date +%s) $kb $vid $chan" >> "$BASE/fetched.tsv"
    echo "$(date +%s) ok" > "$BASE/last"
    log "$chan: range $vid ($((kb / 1024)) Mo)"
  else
    echo "$(date +%s) $vid $chan" >> "$BASE/failed.tsv"
    echo "$(date +%s) fail" > "$BASE/last"
    log "$chan: echec $vid, pas de nouvel essai avant $FAIL_GAP_MIN min"
  fi
  rm -f "$dir/.part"/*
  return 0
}

# The pacing below is one download at a time for the whole board, so taking the
# channels in the order they are configured gives the first one every turn:
# cx247 took all four fetches of 2026-09-18 and nanatty247 none, which left that
# channel running on its Kick supply alone and airing nothing from YouTube.
# The channel that has waited longest goes first instead.
turn() {
  for c in $CHANNELS; do
    printf '%s %s\n' "$(num "$(cat "$BASE/$c.tried" 2>/dev/null)")" "$c"
  done | sort -n | awk '{print $2}'
}

for chan in $CHANNELS; do ship "$chan"; done
for chan in $(turn); do fill "$chan" && break; done
report
exit 0
