#!/bin/sh
# yt2oracle - telecharge des URLs YouTube sur le Claw, pousse le resultat sur Oracle.
#
#   yt2oracle <url> [url...]
#
# Tourne sur le Claw parce que YouTube sert un mur anti-bot aux IP datacenter :
# depuis Oracle, yt-dlp rend "Sign in to confirm you're not a bot". Depuis l'IP
# residentielle du Claw, l'extraction passe sans cookies ni compte.
#
# ponytail: pas de file d'attente, pas de daemon. Un script, un cron. Si tu veux
# suivre des chaines entieres, l'ajout c'est --download-archive, pas un ordonnanceur.
set -eu

DEST_HOST="ubuntu@89.168.60.67"
# Ou livrer, quel morceau, et jusqu'a quelle hauteur. Tout vient de la file, qui
# les tient d'une inbox ecrite sur Oracle; rien n'est de confiance ici et tout
# finit dans une ligne de commande yt-dlp, donc chaque valeur est validee plus
# bas avant d'etre utilisee. Sans rien, c'est exactement le comportement d'avant
# qu'il y ait plusieurs chaines.
DEST_DIR="${DEST_DIR:-/home/ubuntu/videos}"
PART="${PART:-}"
RANGE="${RANGE:-}"
MAXH="${MAXH:-}"
KEY="/root/.ssh/oracle_key"
WORK="/root/yt"
# h264 et aac, jamais autre chose, et c'est le coeur de ce script.
#
# Sans contrainte de codec, "meilleure video 1080p" sur YouTube veut dire AV1
# (f399) ou VP9 (f303), et "meilleur audio" veut dire opus (f251). Aucun des
# trois ne se copie dans un MPEG-TS : la chaine en aval remuxe ce qu'elle recoit
# et reencode tout le reste, a 0.06x le temps reel sur les deux vCPU d'Oracle qui
# alimentent deja la diffusion. Autrement dit chaque video arrivait dans le seul
# format qui coute des heures, et il n'y avait aucune raison a cela: YouTube sert
# la meme video en avc1 et en mp4a si on les demande.
#
# Mesure du 2026-09-08 : les trois telechargements restes en travers sur la carte
# etaient f399, f303 et f136+f251. avc1 pese un peu plus sur le fil que l'AV1, et
# c'est tout ce que ce choix coute.
QUALITY="bv*[vcodec^=avc1][height<=1080][filesize_approx<5500000000]+ba[acodec^=mp4a]/bv*[vcodec^=avc1][height<=720][filesize_approx<5500000000]+ba[acodec^=mp4a]/bv*[vcodec^=avc1][height<=480][filesize_approx<5500000000]+ba[acodec^=mp4a]/bv*[vcodec^=avc1][height<=360]+ba[acodec^=mp4a]"
# Le Claw a 13 Go utiles. Une VOD de six heures en 1080p en fait huit et remplit
# la carte avant d'avoir fini : c'est exactement ce qui a mis /root a 100% et
# fait echouer les 54 telechargements suivants, sans que rien ne le signale.
# prep refuse deja tout ce qui depasse quatre heures, donc rien n'est perdu ici
# qui aurait ete diffuse.
# The card is 15 Go and yt-dlp needs the video, the audio and the merged output
# on it at once, so the finished file has to stay under about a third of that.
# The format selector already prefers a rung that fits, but it can only use the
# approximate size YouTube reports and that is missing often enough to matter:
# a 12h VOD was seen picking 1080p60 through it on 2026-09-08. This is the hard
# stop, and it aborts before the bytes land rather than after.
# 4G refused the 1080p rendition of anything past about two hours and the
# selector fell through to 720p, silently. Measured 2026-09-14 on a 2.74 h
# source: 1080p60 is 4.62 GiB against 2.61 for 720p, so the cap was exactly
# what chose the lower one. At about 1.7 Go per hour, 5500M covers 1080p up
# to the three hour ceiling the collector already enforces, and the selector
# still falls back for the rare heavier source rather than fetching nothing.
#
# The board's card bounds this, not taste: the download writes the video and
# the audio separately and then merges, so peak usage is about twice the
# final size. 5500M peaks near 11 Go against 13 Go free. Raising it further
# needs a larger card, not a larger number.
MAX_FILESIZE=5500M
MAX_DURATION=86400
KEEP_FREE_MB=2048
# Une ligne, la sortie a emprunter, par exemple socks5://127.0.0.1:1080 ou
# http://user:pass@hote:port. Fichier absent ou vide = sortie directe.
#
# Le 2026-09-08 l'IP de la maison est passee dans le meme sac qu'une IP
# datacenter pour l'API player de YouTube: toutes les videos ont repondu "Sign
# in to confirm you're not a bot", en IPv4 comme en IPv6, sur les sept clients
# player, et pendant ce temps le listing de playlist passait toujours. Le mur
# est sur le player, pas sur le compte, et il suit l'abonne. La seule sortie
# logicielle est donc de sortir par ailleurs.
#
# Attention a ce qu'on met dedans: un proxy datacenter tombe sur exactement le
# meme mur, c'est deja verifie sur Oracle. Il faut une sortie residentielle.
PROXY_FILE="$WORK/proxy.conf"
# Cookies Netscape d'un compte YouTube connecte. Fichier absent = sans cookies.
#
# C'est ce que le mur reclame littericalement ("Use --cookies-from-browser or
# --cookies"), et le 2026-09-08 c'est la seule chose qui restait: eliminees par
# mesure ce jour-la, l'IPv4 de la maison, son IPv6, l'IP datacenter d'Oracle et
# une sortie Cloudflare WARP renvoient toutes le meme refus, sur les sept
# clients player, avec yt-dlp a jour et un fournisseur de PO token charge. Le
# listing de playlist, lui, passe toujours: le mur est sur l'API player seule.
#
# Utiliser un compte jetable et pas le compte principal: un compte qui tire des
# centaines de VOD se fait signaler, et ce serait le compte de quelqu'un.
COOKIES_FILE="$WORK/cookies.txt"
# /var/log est un lien vers /tmp, un tmpfs en RAM : un log ecrit la disparait au
# reboot. /root est sur la carte SD.
LOG="$WORK/yt2oracle.log"

SSH="ssh -i $KEY -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=20"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" | tee -a "$LOG"; }

# Un telechargement interrompu laisse ses .part et ses pistes separees derriere
# lui. Trois d'entre eux ont occupe 14,6 Go pendant trois jours et la carte est
# restee pleine, donc chaque run suivant mourait sur le controle de place libre.
# Le menage se fait au moment de l'echec, pas un jour plus tard.
sweep() {
  # *.temp.* : un merge interrompu laisse le fichier fusionne a moitie
  # ecrit. Cest la panne des 14,6 Go de septembre avec un autre suffixe:
  # le 2026-09-08 un merge de 4 Go tue par lOOM en a laisse 1,5 Go en
  # travers, et rien ne les ramassait.
  rm -f "$WORK"/*.part "$WORK"/*.ytdl "$WORK"/*.temp.* 2>/dev/null || true
  # Le suffixe de format n'est pas toujours ".fNNN.": yt-dlp ecrit aussi
  # ".f140-12.m4a" quand il numerote plusieurs pistes d'un meme format, et un
  # de ceux-la est reste 12 heures sur la carte parce que les motifs ci-dessous
  # exigeaient un point juste apres les trois chiffres.
  rm -f "$WORK"/*.f[0-9][0-9][0-9]*.mp4 "$WORK"/*.f[0-9][0-9][0-9]*.webm \
        "$WORK"/*.f[0-9][0-9][0-9]*.m4a "$WORK"/*.f[0-9][0-9][0-9]*.mkv \
        2>/dev/null || true
}

die() { sweep; log "ECHEC: $*"; exit 1; }

mkdir -p "$WORK"

[ $# -gt 0 ] || die "usage: yt2oracle <url> [url...]"
command -v yt-dlp >/dev/null || die "yt-dlp absent"

# Les quatre valeurs qui viennent de l'exterieur, verifiees avant usage. Le
# suffixe de DEST_DIR n'admet que des minuscules, des chiffres et des tirets:
# une bibliotheque est /home/ubuntu/videos ou /home/ubuntu/videos-<nom>, et rien
# d'autre ne doit pouvoir etre ecrit sur Oracle par ce script.
suffix=${DEST_DIR#/home/ubuntu/videos}
case "$suffix" in
  "") ;;
  -*) case "$suffix" in *[!a-z0-9-]*) die "DEST_DIR refuse: $DEST_DIR" ;; esac ;;
  *) die "DEST_DIR refuse: $DEST_DIR" ;;
esac
case "$PART" in
  "") ;;
  p[0-9]*of[0-9]*) case "$PART" in *[!0-9pof]*) die "PART refuse: $PART" ;; esac ;;
  *) die "PART refuse: $PART" ;;
esac
case "$RANGE" in
  "") ;;
  [0-9]*-[0-9]*) case "$RANGE" in *[!0-9-]*) die "RANGE refuse: $RANGE" ;; esac ;;
  *) die "RANGE refuse: $RANGE" ;;
esac
case "$MAXH" in "" | 1080 | 720 | 480 | 360) ;; *) die "MAXH refuse: $MAXH" ;; esac
# Un morceau sans tranche telechargerait la video entiere sous le nom d'un
# morceau, et les sept autres morceaux viendraient se poser a cote.
[ -z "$PART" ] || [ -n "$RANGE" ] || die "PART sans RANGE"

# Le stock: des videos telechargees d'avance et gardees sur la carte, par
# bibliotheque et par hauteur, depuis que la carte fait 128 Go. yt2oracle-stock
# le remplit a son rythme. Ici on le lit (une livraison sert d'abord ce qui est
# deja la, sans redemander a YouTube) ou on y range (STOCK_ONLY=1: telecharger
# et garder, sans rien envoyer a Oracle). Seule une video entiere se stocke.
STOCK_ONLY="${STOCK_ONLY:-}"
STOCK_DIR="$WORK/stock/${DEST_DIR#/home/ubuntu/}/h${MAXH:-any}"
vid=""
if [ -z "$PART" ] && [ $# -eq 1 ]; then
  vid=${1##*[=/]}
  case "$vid" in *[!A-Za-z0-9_-]*) vid="" ;; esac
  [ ${#vid} -eq 11 ] || vid=""
fi
[ -z "$STOCK_ONLY" ] || [ -n "$vid" ] || die "STOCK_ONLY exige une seule video entiere"
stocked=""
if [ -n "$vid" ]; then
  stocked=$(ls "$STOCK_DIR"/*-"$vid".mkv "$STOCK_DIR"/*-"$vid".mp4 "$STOCK_DIR"/*-"$vid".webm 2>/dev/null | head -1) || stocked=""
fi

# Le Claw n'a que ~13 Go. On refuse de commencer si la place locale est deja basse,
# sinon un gros download remplit la carte SD et casse le reste de la machine.
local_free=$(df -Pm "$WORK" | tail -1 | awk '{print $4}')
[ "$local_free" -gt "$KEEP_FREE_MB" ] || die "place locale: ${local_free} Mo libres, minimum ${KEEP_FREE_MB} Mo"

# Un proxy casse ne doit pas casser la chaine: on l'essaie, et s'il ne repond
# pas on sort en direct plutot que de rendre chaque tick inutile. Le direct
# echouera peut-etre sur le mur anti-bot, mais ca c'est un echec informatif et
# pas un echec de plomberie.
PROXY=""
if [ -s "$PROXY_FILE" ]; then
  want=$(sed -n 's/^[[:space:]]*\([^#][^[:space:]]*\).*/\1/p' "$PROXY_FILE" | head -1)
  if [ -n "$want" ]; then
    if curl -s --max-time 20 --proxy "$want" https://api.ipify.org >/dev/null 2>&1; then
      PROXY="$want"
      log "proxy: sortie par $(curl -s --max-time 20 --proxy "$want" https://api.ipify.org)"
    else
      log "proxy: $want ne repond pas, sortie directe pour ce run"
    fi
  fi
fi

COOKIES=""
if [ -s "$COOKIES_FILE" ]; then
  COOKIES="$COOKIES_FILE"
  log "cookies: $COOKIES_FILE ($(wc -l < "$COOKIES_FILE") lignes)"
fi

[ -n "$stocked" ] || log "download: $*"
# Le mur anti-bot de YouTube est intermittent, pas absolu: le 2026-09-08 la meme
# video est passee puis s'est fait refuser sept minutes plus tard, 12 reussites
# contre 42 refus sur la journee. Attendre le tick suivant coute cinq minutes
# pour un seul essai; reessayer tout de suite dans le meme run, a une chance sur
# cinq par essai, en donne pres de trois sur quatre. Un refus coute quarante
# secondes, donc quatre essais tiennent largement dans un tick.
#
# sweep entre deux essais: un refus arrive parfois apres le debut du telechargement
# et laisse des morceaux, que l'essai suivant prendrait pour les siens.
TRIES=4
RETRY_SLEEP=20
# Le remplissage du stock n'est jamais presse: un refus y attend son prochain
# creneau au lieu d'insister, c'est ce qui l'empeche de faire signaler l'adresse.
[ -z "$STOCK_ONLY" ] || TRIES=1

# Ce qui change quand on demande un MORCEAU plutot qu'une video.
#
# filesize_approx est la taille de la video ENTIERE, pas celle de la tranche.
# Sur un flux de onze heures aucun palier ne passe sous les 4 Go, donc le
# selecteur ci-dessus ne rendrait rien du tout et --max-filesize avorterait
# avant le premier octet. Ce qui borne un morceau, c'est sa duree.
#
# La hauteur demandee est celle que la chaine diffuse: tirer du 1080p pour
# emettre du 720p coute trois fois la carte, le lien et l'encodage pour une
# image que personne ne voit.
SIZE_ARGS="--max-filesize $MAX_FILESIZE"
SECTION=""
OUTTMPL='%(title).120B-%(id)s.%(ext)s'
if [ -n "$PART" ]; then
  SIZE_ARGS=""
  # L'etoile fait partie de la syntaxe de yt-dlp: sans elle, l'argument est lu
  # comme une expression reguliere sur les titres de chapitres. Elle est donc
  # passee entre guillemets DANS l'expansion, sinon le shell la developpe sur
  # le repertoire courant avant que yt-dlp ne la voie.
  SECTION="*$RANGE"
  OUTTMPL="%(title).120B-%(id)s.$PART.%(ext)s"
  QUALITY="bv*[vcodec^=avc1][height<=${MAXH:-720}]+ba[acodec^=mp4a]/bv*[vcodec^=avc1][height<=480]+ba[acodec^=mp4a]/bv*[vcodec^=avc1][height<=360]+ba[acodec^=mp4a]"
elif [ -n "$MAXH" ] && [ "$MAXH" -lt 1080 ]; then
  QUALITY="bv*[vcodec^=avc1][height<=$MAXH][filesize_approx<5500000000]+ba[acodec^=mp4a]/bv*[vcodec^=avc1][height<=480][filesize_approx<5500000000]+ba[acodec^=mp4a]/bv*[vcodec^=avc1][height<=360]+ba[acodec^=mp4a]"
fi

# --restrict-filenames : noms reduits a [A-Za-z0-9._-], donc plus aucun probleme de
# quoting quand les noms repassent par scp et ssh plus bas.
#
# --force-ipv4 : le Claw a une IPv6 publique et YouTube se resout chez lui en
# IPv6, la ou le PC de la maison n'en a pas et sort en IPv4. Mesure 2026-09-13
# 00:38 sur le Claw, meme video, meme minute : IPv4 forcee rend 137+140 en
# 1920x1080, IPv6 rend "Sign in to confirm you're not a bot". Les 365 echecs
# accumules depuis le 10 sont tous passes par l'IPv6. Le 2026-09-08 les deux
# familles etaient refusees : le mur bouge, c'est la mesure du jour qui tranche.
fetch() {
  yt-dlp \
    --force-ipv4 \
    ${PROXY:+--proxy "$PROXY"} \
    ${COOKIES:+--cookies "$COOKIES"} \
    --no-playlist \
    --restrict-filenames \
    --no-progress \
    $SIZE_ARGS \
    ${SECTION:+--download-sections} ${SECTION:+"$SECTION"} \
    -f "$QUALITY" \
    --match-filter "duration < $MAX_DURATION" \
    --merge-output-format mkv \
    -P "$WORK" \
    -o "$OUTTMPL" \
    "$@" >>"$LOG" 2>&1
}

if [ -n "$stocked" ]; then
  mv -f "$stocked" "$WORK/" || die "stock: impossible de reprendre $stocked"
  log "stock: servi depuis la carte, $(basename "$stocked")"
else
  # L'heure du dernier appel a YouTube, livraison ou stock: c'est l'adresse qui
  # se fait signaler, pas le script, donc le stock espace ses essais de celui-ci.
  { mkdir -p "$WORK/stock" && touch "$WORK/stock/.last_fetch"; } || true
  attempt=1
  while : ; do
    if fetch "$@"; then break; fi
    if [ "$attempt" -ge "$TRIES" ]; then
      die "yt-dlp refuse apres $attempt essai(s) (voir $LOG)"
    fi
    log "essai $attempt/$TRIES refuse, nouvel essai dans ${RETRY_SLEEP}s"
    sweep
    attempt=$((attempt + 1))
    sleep "$RETRY_SLEEP"
  done
  # pas de "[ ... ] && log" ici: sous set -e, un test faux au premier essai tuerait
  # le script juste apres un telechargement reussi.
  if [ "$attempt" -gt 1 ]; then
    log "passe au ${attempt}e essai"
  fi
fi

# On ne pousse que ce qui vient d'etre produit, pas un residu d'un run precedent.
files=$(find "$WORK" -maxdepth 1 -type f \( -name '*.mp4' -o -name '*.mkv' -o -name '*.webm' \))
# Un temp laisse par un merge tue nest jamais passe par sweep, et il est
# parfaitement lisible: un merge coupe a 3 h sur 11 h ne se voit nulle part
# en aval. Sans cette ligne le run suivant le televerse comme la video.
files=$(echo "$files" | sed "/[.]temp[.]/d")
# En remplissage de stock, seul le fichier de la video demandee est range: un
# residu laisse par un envoi rate appartient a sa propre livraison.
[ -z "$STOCK_ONLY" ] || files=$(echo "$files" | grep -F -- "-$vid." || true)
[ -n "$files" ] || die "rien telecharge (trop long, ou pas d'avc1 disponible)"

need_kb=$(du -sk $files | awk '{s+=$1} END {print s}')

if [ -n "$STOCK_ONLY" ]; then
  mkdir -p "$STOCK_DIR"
  for f in $files; do mv -f "$f" "$STOCK_DIR/" || die "stock: rangement impossible de $f"; done
  log "stock: $((need_kb / 1024)) Mo ranges dans $STOCK_DIR"
  exit 0
fi

# On depose d'abord dans un sous-dossier, et on ne renomme qu'apres verification.
# prep balaie la bibliotheque en boucle et sonde chaque fichier qu'il y trouve;
# un fichier encore en cours d'arrivee est illisible, le verdict "incopiable"
# est mis en cache sous sa taille du moment, et plus rien ne le reexamine. Ca
# s'est produit trois fois le 2026-09-08, dont une sous la taille FINALE parce
# que scp avait fini d'ecrire les octets sans que le fichier soit complet.
# Un mv sur le meme systeme de fichiers est atomique: prep voit le fichier
# entier ou ne le voit pas.
STAGE="$DEST_DIR/.arrivee"
$SSH "$DEST_HOST" "mkdir -p '$DEST_DIR' '$STAGE'" || die "ssh vers Oracle impossible (cle autorisee ?)"

# Oracle heberge aussi la prod kicknosub sur 45 Go. Remplir ce disque casserait
# le service, donc on verifie avant de copier, pas apres.
remote_free_kb=$($SSH "$DEST_HOST" "df -Pk '$DEST_DIR' | tail -1 | awk '{print \$4}'")
margin_kb=$((KEEP_FREE_MB * 1024))
[ $((remote_free_kb - need_kb)) -gt "$margin_kb" ] \
  || die "place Oracle: besoin $((need_kb/1024)) Mo, libre $((remote_free_kb/1024)) Mo, marge $KEEP_FREE_MB Mo"

log "upload: $((need_kb/1024)) Mo vers $DEST_HOST:$STAGE"
scp -i "$KEY" -o BatchMode=yes -o StrictHostKeyChecking=accept-new $files "$DEST_HOST:$STAGE/" >>"$LOG" 2>&1 \
  || die "scp a rendu $?"

# Verification fichier par fichier : sans ca un scp tronque passerait pour un succes,
# et on supprimerait la seule copie locale juste apres. Le fichier n'entre dans
# la bibliotheque qu'une fois sa taille confirmee, et il y entre d'un seul coup.
rc=0
for f in $files; do
  name=$(basename "$f")
  local_size=$(wc -c < "$f")
  remote_size=$($SSH "$DEST_HOST" "wc -c < '$STAGE/$name'" 2>/dev/null || echo -1)
  if [ "$local_size" = "$remote_size" ]; then
    if ! $SSH "$DEST_HOST" "mv -f '$STAGE/$name' '$DEST_DIR/$name'"; then
      log "MISMATCH publication impossible pour $name (copie locale gardee)"
      rc=1
      continue
    fi
    log "OK $local_size o $name"
    rm -f "$f"
  else
    $SSH "$DEST_HOST" "rm -f '$STAGE/$name'" 2>/dev/null || true
    log "MISMATCH local=$local_size distant=$remote_size $name (copie locale gardee)"
    rc=1
  fi
done

[ "$rc" -eq 0 ] || die "au moins un fichier n'a pas ete verifie"
log "termine"
