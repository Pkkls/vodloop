#!/bin/sh
# yt2oracle-queue - draine /root/yt/urls.txt, une URL par tick de cron.
#
# Depose des URLs (une par ligne, # pour commenter) dans /root/yt/urls.txt depuis
# n'importe ou. Le cron s'occupe du reste, PC eteint.
#
# ponytail: pas de daemon, pas de file d'attente en base. Un fichier texte, un
# verrou par mkdir, un cron. Le plafond c'est une URL par tick (le Claw a 1 coeur
# RISC-V et un upload de 46 Mo coute ~60 s) ; si tu veux du parallelisme un jour,
# c'est la machine qu'il faut changer, pas ce script.
set -u

QUEUE=/root/yt/urls.txt
DONE=/root/yt/done.txt
FAILED=/root/yt/failed.txt
LOCK=/tmp/yt2oracle-queue.lock
LOG=/root/yt/yt2oracle.log

ts() { date '+%Y-%m-%d %H:%M:%S'; }

# mkdir est atomique : un seul tick gagne, les suivants sortent au lieu de s'empiler.
# S99clawd a deja paye cette facture (trois boucles keepalive qui se battaient sur les
# memes tokens). Le verrou vit dans /tmp, donc un reboot le nettoie tout seul.
#
# Mais entre deux reboots, un run tue par SIGKILL laisse le verrou derriere lui et la
# file devient inerte SANS que rien ne le signale. C'est le mode de panne silencieuse
# que ce systeme ne doit pas avoir. On rattrape donc, mais sur la vie du proprietaire
# et pas sur l'age du verrou.
#
# L'age ne marche pas. Il a ete regle sur 30 min quand le plus long run observe faisait
# 6 minutes, puis MAX_DURATION est passe de 3 h a 24 h : le 2026-09-08 a 06:20 un
# telechargement de 11 h 15 en cours depuis 30 minutes a ete declare orphelin, son
# verrou retire, et un second run est parti sur le meme coeur et la meme carte pendant
# que le premier fusionnait 3,5 Go. A un tick toutes les 5 minutes c'est six runs
# concurrents en une demi-heure, ce qui est exactement la panne de trois jours de
# septembre : carte pleine, tout echoue sur son propre controle d'espace.
#
# Le PID du proprietaire est donc ecrit dans le verrou et c'est /proc qui repond. Un run
# vivant garde son verrou aussi longtemps qu'il travaille. Le PID peut etre recycle, et
# alors on saute un tick : l'erreur est du cote sur. L'age ne sert plus que de recours
# pour un verrou sans PID, laisse par la version d'avant.
STALE_MIN=30
if [ -d "$LOCK" ]; then
  owner=$(cat "$LOCK/pid" 2>/dev/null)
  if [ -n "$owner" ] && [ -d "/proc/$owner" ]; then
    exit 0
  fi
  if [ -z "$owner" ] && [ -n "$(find "$LOCK" -maxdepth 0 -mmin -$STALE_MIN 2>/dev/null)" ]; then
    exit 0
  fi
  echo "$(ts) queue: verrou orphelin (pid ${owner:-inconnu} mort), retire" >> "$LOG"
  rm -rf "$LOCK"
fi

mkdir "$LOCK" 2>/dev/null || exit 0
echo $$ > "$LOCK/pid"
trap 'rm -rf "$LOCK"' EXIT INT TERM

[ -f "$QUEUE" ] || exit 0

# Une carte, une file, plusieurs chaines. En prenant les lignes dans l'ordre, la
# chaine dont l'inbox est la plus profonde prend tous les ticks jusqu'a ce
# qu'elle se vide, et l'autre attend des heures: sur une chaine 24/7 c'est la
# difference entre une rotation et la meme soiree rejouee. On prend donc la
# premiere ligne qui n'est PAS pour la chaine servie au tick precedent, et
# l'ordre a l'interieur d'une chaine reste celui de sa file.
LAST_DEST=/root/yt/last_dest
last=$(cat "$LAST_DEST" 2>/dev/null) || last=""
useful=$(grep -vE '^[[:space:]]*(#|$)' "$QUEUE")
# On resout la destination de CHAQUE ligne avant de comparer, au lieu de
# chercher le texte " dest=<last>" dedans. Une ligne d'avant les destinations
# n'a pas de jeton du tout et appartient a la premiere chaine: cherchee par son
# texte elle ne correspondait a rien, donc elle n'etait jamais ecartee et
# head -1 la reprenait sans fin. Mesure le 2026-09-13: trois telechargements
# cx247 d'affilee pendant que les huit lignes de l'autre chaine attendaient.
#
# last vide, ou une seule chaine en file: aucune ligne ne peut etre ecartee et
# on retombe sur la premiere, comme avant qu'il y en ait deux.
line=$(printf '%s\n' "$useful" | awk -v last="$last" '
  {
    d = "videos"
    for (i = 1; i <= NF; i++) if ($i ~ /^dest=/) d = substr($i, 6)
    if (d != last) { print; exit }
  }')
[ -n "$line" ] || line=$(printf '%s\n' "$useful" | head -1)
[ -n "$line" ] || exit 0

# On retire la ligne AVANT de la traiter. Sinon une URL definitivement cassee revient a
# chaque tick et bloque la file derriere elle. L'echec est trace dans failed.txt, il
# n'est pas silencieux.
# Pas de "&&" apres le grep : quand la file se vide, grep rend 1 et l'URL resterait
# en place, donc boucle infinie.
grep -vxF "$line" "$QUEUE" > "$QUEUE.tmp"
mv "$QUEUE.tmp" "$QUEUE"

# Une ligne est une URL et, au plus, la destination, le morceau demande, sa
# tranche et la hauteur. Tout a deja ete filtre par inbox-pull; ici on ne fait
# que separer. Une ligne d'avant les destinations n'a que l'URL et retombe donc
# sur la bibliotheque de la premiere chaine.
url=""; dest=videos; part=""; range=""; maxh=""
for tok in $line; do
  case "$tok" in
    dest=*) dest=${tok#dest=} ;;
    part=*) part=${tok#part=} ;;
    range=*) range=${tok#range=} ;;
    h=*) maxh=${tok#h=} ;;
    *) [ -n "$url" ] || url=$tok ;;
  esac
done
[ -n "$url" ] || exit 0
# Ecrit avant le telechargement: un run tue en cours de route a quand meme
# consomme son tour, et le tick suivant doit aller a l'autre chaine.
echo "$dest" > "$LAST_DEST"

# Nombre d'essais avant d'abandonner pour de bon. Le mur anti-bot de YouTube est
# INTERMITTENT, pas absolu: mesure le 2026-09-08, 12 reussites contre 42 echecs
# dans la journee, et deux tentatives sur la meme video a sept minutes d'ecart
# ont donne un passage puis un refus. Abandonner au premier refus mettait donc
# presque tout dans failed.txt et vidait la bibliotheque, ce qui a fini en
# ecran de veille a l'antenne. Une URL revient en fin de file tant qu'elle n'a
# pas epuise ses essais: la file continue d'avancer, elle ne bloque pas dessus.
MAX_ATTEMPTS=6
ATTEMPTS=/root/yt/attempts.txt

attempts_of() {
  [ -f "$ATTEMPTS" ] || { echo 0; return; }
  n=$(grep -cxF "$1" "$ATTEMPTS" 2>/dev/null) || n=0
  echo "$n"
}

# Les essais se comptent sur la ligne et pas sur l'URL: deux morceaux d'une
# meme video sont deux telechargements differents, et l'echec de l'un ne dit
# rien de l'autre.
if DEST_DIR="/home/ubuntu/$dest" PART="$part" RANGE="$range" MAXH="$maxh" yt2oracle "$url"; then
  echo "$(ts) $line" >> "$DONE"
  # une reussite efface l'ardoise: si la video revient un jour, elle repart de zero
  if [ -f "$ATTEMPTS" ]; then
    grep -vxF "$line" "$ATTEMPTS" > "$ATTEMPTS.tmp" 2>/dev/null
    mv "$ATTEMPTS.tmp" "$ATTEMPTS"
  fi
else
  echo "$line" >> "$ATTEMPTS"
  tried=$(attempts_of "$line")
  if [ "$tried" -lt "$MAX_ATTEMPTS" ]; then
    echo "$line" >> "$QUEUE"
    echo "$(ts) queue: echec ${tried}/${MAX_ATTEMPTS}, url remise en fin de file" >> "$LOG"
  else
    echo "$(ts) $line" >> "$FAILED"
    echo "$(ts) queue: echec ${tried}/${MAX_ATTEMPTS}, abandon, voir $FAILED" >> "$LOG"
  fi
fi
