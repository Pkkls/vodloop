[Unit]
Description=vodloop dashboard
After=network-online.target

[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/vodloop
EnvironmentFile=/home/ubuntu/vodloop/web.env
ExecStart=/usr/bin/python3 /home/ubuntu/vodloop/bin/dashboard.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
