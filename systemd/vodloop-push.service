[Unit]
# The connection to Kick. Restarting this unit ends the live stream, starts a
# new VOD and drops every viewer, so deployments must never touch it. The
# placeholder FIFO writer lives in this cgroup on purpose: systemd kills a whole
# control group on restart, and if that writer sat in the feeder unit instead,
# every feeder restart would take the stream down with it.
Description=vodloop RTMPS pusher
After=network-online.target
Wants=network-online.target
# The feeder is BindsTo= this unit, and BindsTo only ever propagates a stop. So
# a pusher crash took the feeder down with it, Restart= brought the pusher back
# alone, and the channel stayed dark until someone looked. Pulling the feeder in
# on every start closes that. Not Upholds=, which would also undo the deliberate
# feeder stop behind "vodloopctl pause".
Wants=vodloop-feed.service

[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/vodloop
ExecStart=/home/ubuntu/vodloop/bin/pusher.sh
Restart=always
RestartSec=5
# a stall on the wire should not be mistaken for a crash
TimeoutStopSec=20
# ffmpeg exits 255 when it is asked to stop mid-session. Without this, every
# deliberate stop leaves the unit in "failed" and a real failure stops standing out.
SuccessExitStatus=255

[Install]
WantedBy=multi-user.target
