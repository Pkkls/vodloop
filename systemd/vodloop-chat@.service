[Unit]
Description=vodloop chat commands (%i)
After=network-online.target

[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/vodloop
# the app credentials, so the bot can answer in chat. They reach the process
# through its environment only: never in argv, never in a file it reads itself.
EnvironmentFile=/home/ubuntu/%i/bus.env
Environment=VODLOOP_ROOT=/home/ubuntu/%i
# The same folder prep plays from, because the chat can only offer what is on
# disk. Without it every request is answered "the library is empty", which is
# indistinguishable from a broken bot.
Environment=VODLOOP_LIBRARY=/home/ubuntu/videos-%i
Environment=VODLOOP_UNIT=vodloop-%%s@%i
# KICK_USER_ID is not set here on purpose: chat.py reads it from this root's
# own .env, and it is what tells this instance which broadcaster's events on the
# shared bus are its own. Wrong or missing, the neighbour's viewers reorder this
# channel's queue.
ExecStart=/usr/bin/python3 /home/ubuntu/vodloop/bin/chat.py
Restart=always
RestartSec=5
# this process only ever talks to loopback and writes inside its own directory
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/%i

[Install]
WantedBy=multi-user.target
