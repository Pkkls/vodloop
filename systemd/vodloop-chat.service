[Unit]
Description=vodloop chat commands
After=network-online.target

[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/vodloop
# the app credentials, so the bot can answer in chat. They reach the process
# through its environment only: never in argv, never in a file it reads itself.
EnvironmentFile=/home/ubuntu/vodloop/bus.env
Environment=KICK_USER_ID=127469285
ExecStart=/usr/bin/python3 /home/ubuntu/vodloop/bin/chat.py
Restart=always
RestartSec=5
# this process only ever talks to loopback and writes inside its own directory
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/vodloop

[Install]
WantedBy=multi-user.target
